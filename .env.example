# ==== LLM Providers (FREE MODELS ONLY) ====
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# LiteLLM model routing (must be free-tier models)
PRIMARY_MODEL=groq/llama-3.3-70b-versatile
FALLBACK_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct:free

# ==== Browser ====
CHROME_REMOTE_DEBUG_PORT=9222
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000

# ==== Agent Behavior ====
DEFAULT_LANGUAGE=python
MAX_RETRY_COUNT=5
RETRY_BACKOFF_SECONDS=2

# ==== Database ====
SQLITE_DB_PATH=./database/app.db
CHROMA_PERSIST_DIR=./database/chroma
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=false

# ==== API ====
API_HOST=0.0.0.0
API_PORT=8000

# ==== Logging ====
LOG_LEVEL=INFO
