FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml .
RUN uv pip install --system --no-cache -e . || uv pip install --system --no-cache fastapi uvicorn langgraph litellm playwright pydantic pydantic-settings sqlalchemy aiosqlite chromadb redis beautifulsoup4 lxml rich python-dotenv httpx

RUN playwright install --with-deps chromium

COPY backend ./backend
COPY database ./database

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
